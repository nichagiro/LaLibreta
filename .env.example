# Configuración del Frontend (Build Estático)
# URL de la Web App desplegada en Google Apps Script
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# Token personal validado por Apps Script. VITE_* se publica dentro del bundle:
# no es un secreto robusto; limita su uso a una SPA privada y no agregues credenciales de Google.
VITE_APP_AUTH_TOKEN=tu_clave_de_acceso_personal_aqui

# Nombre de la aplicación y moneda por defecto
VITE_APP_TITLE="Control de Ingresos"
VITE_DEFAULT_CURRENCY=COP
VITE_TIMEZONE=America/Bogota
